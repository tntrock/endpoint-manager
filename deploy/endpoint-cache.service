# systemd unit。安裝步驟見 README「安裝快取（Linux）」：
#   sudo useradd --system --no-create-home endpoint-cache
#   sudo install -d -o endpoint-cache -m 0700 /var/lib/endpoint-cache
#   sudo -u endpoint-cache endpoint-cache enroll --data-dir /var/lib/endpoint-cache ...
#   sudo systemctl enable --now endpoint-cache   （核准前服務會每 30 秒詢問一次）
# 自訂儲存目錄（config.json 的 storage_dir）時要加上 ReadWritePaths=<目錄>。
[Unit]
Description=Endpoint Manager branch cache
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/endpoint-cache run --data-dir /var/lib/endpoint-cache
Restart=on-failure
RestartSec=10
# 每個端點下載是一條連線；預設 1024 個檔案描述元不夠
LimitNOFILE=65536
User=endpoint-cache
StateDirectory=endpoint-cache
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# 監聽 1024 以下的埠時才需要
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
